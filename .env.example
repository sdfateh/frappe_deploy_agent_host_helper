# Per-server hardened Agent/Worker environment. Copy this file outside the Git
# checkout, replace every placeholder, and keep the completed file mode 0600.

# ─── Cloudflare ───────────────────────────────────────────────────────────────
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
SERVER_IP=1.2.3.4

# ─── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET=prod-kaleam-erp-backup
# Exact buckets and parent prefixes the agent may read. JSON lists.
S3_ALLOWED_BUCKETS=["prod-kaleam-erp-backup"]
S3_ALLOWED_PREFIXES=[""]
S3_MAX_OBJECT_BYTES=21474836480
S3_MAX_RESTORE_BYTES=42949672960
S3_REQUIRE_CHECKSUM=true
# Restores fail closed unless the bucket has versioning enabled. IAM also needs
# s3:GetBucketVersioning, s3:ListBucketVersions, and s3:GetObjectVersion.

# ─── Typed host helper ────────────────────────────────────────────────────────
# The hardened deployment mounts this socket; Docker and the DB root password
# remain exclusively in the root-owned helper configuration.
FRAPPE_HOST_HELPER_SOCKET=/run/frappe-agent/helper.sock
# The installer replaces "auto" with the server's actual frappe-agent group GID.
FRAPPE_HOST_HELPER_GID=auto
# Administrator-owned registry shared with the agent as read-only. Each profile's
# host_staging_path must be beneath BENCH_STAGING_ROOT and use the same absolute
# path in the agent and backend containers.
# NOTE: /etc/frappe-agent/benches.yaml still needs to be created on this host
# before --start-agent; see deploy/bench-registry.production.yaml for dev3.
BENCH_REGISTRY_FILE=/etc/frappe-agent/benches.yaml
# dev3's host_staging_path (/tmp/frappe-staging/dev3) lives under this root.
BENCH_STAGING_ROOT=/tmp/frappe-staging
# One level above the Docker-managed named volume backing dev3's sites, so only
# dev3's own volume is exposed read-only into the Agent/Worker containers
# (not every named volume on the host).
BENCH_SITES_ROOT=/var/lib/docker/volumes/dev-erp3_sites
INVENTORY_RECONCILE_INTERVAL_SECONDS=300

# Durable journal and the single standalone worker. The API and worker share
# /app/data through agent_data; the worker enforces an OS singleton lock.
OPERATION_DEFAULT_MAX_ATTEMPTS=3
OPERATION_EVENT_BATCH_SIZE=20
OPERATION_RESULT_BATCH_SIZE=50
OPERATION_WORKER_POLL_INTERVAL_SECONDS=0.5
OPERATION_WORKER_LEASE_SECONDS=60
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_RETRY_BASE_SECONDS=5
OPERATION_RETRY_MAX_SECONDS=300
# ─── Traefik ──────────────────────────────────────────────────────────────────
TRAEFIK_DYNAMIC_CONFIG_PATH=/deploy/proxy/simple-traefik/config/dynamic
TRAEFIK_FRONTEND_SERVICE=dev-erp3@docker

# ─── Staging directory ────────────────────────────────────────────────────────
# IMPORTANT: this path must be bind-mounted into the backend container so that
BENCH_COMMAND_TIMEOUT_SECONDS=1800
BENCH_OUTPUT_LIMIT_BYTES=262144
# `bench restore` can read the downloaded .sql.gz file.
# Example compose.ymal volume entry:
#   volumes:
#     - /tmp/frappe_templates:/tmp/frappe_templates
STAGING_DIR=/tmp/frappe_templates/

# ─── Hardened outbound controller deployment ─────────────────────────────────
# NOT OPTIONAL: compose.yml hardcodes OUTBOUND_CONTROLLER_ENABLED=true and
# requires a real CONTROLLER_URL. Deliberately no certificate of any kind:
# the controller is trusted purely because it's reachable only by container
# hostname on the isolated "bench" Docker network (see compose.yml's networks
# section), never over the public internet. Do not run --start-agent until
# the frappe_controller app is actually installed on dev3's site.
# Use the registry digest emitted by the scanned CI build, without `sha256:`.
AGENT_IMAGE_REPOSITORY=kaleam/frappe-deploy-agent
AGENT_IMAGE_TAG=latest
AGENT_ID=server-agent-01
# Internal container hostname:port for dev3's Frappe frontend/backend, plain
# HTTP, e.g. http://frontend:8080 (matches dev-erp3/compose.yml's services).
CONTROLLER_URL=
# Only needed if dev3's bench hosts more than one site.
CONTROLLER_SITE_NAME=
CONTROLLER_AUDIENCE=frappe-controller
CONTROLLER_ALLOWED_OPERATIONS=["site.create","site.reinstall","operation.cancel"]
CONTROLLER_POLL_INTERVAL_SECONDS=5
CONTROLLER_REQUEST_TIMEOUT_SECONDS=30
# dev-erp3's Compose-generated internal network name. Confirm with:
# docker network ls | grep dev-erp3
BENCH_DOCKER_NETWORK=dev-erp3_internal_network

# Optional typed data updates. Leave both empty when the feature is disabled.
DATA_UPDATE_POLICY_FILE=
DATA_UPDATE_POLICY_PATH=

# ─── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Redis URL — points to the redis service defined in docker-compose.yml
# Override only if you use an external Redis instance
REDIS_URL=redis://redis:6379/0

# Required API authentication. Generate with: openssl rand -hex 32
API_KEY=

# Agent-owned staging directories older than this are pruned at startup.
STAGING_MAX_AGE_HOURS=24
# Same-origin access does not require CORS. Add only trusted controller/UI origins.
ALLOWED_ORIGINS=[]

# Required on first startup. JSON list of controller, VPN, or reverse-proxy CIDRs.
IP_ALLOWLIST_BOOTSTRAP=["10.20.0.0/16"]

# Trust forwarded client addresses only from reverse proxies you operate.
TRUSTED_PROXY_NETWORKS=[]
